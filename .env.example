# Orbital Insight — environment configuration
#
# The application runs fully without any of these variables in read-only
# demo mode (browser-local watchlists, live/cached provider data only).
# Configure Supabase only when you want server-side snapshots/watchlists.

# --- Supabase (optional) ---------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Service-role key (SERVER-SIDE ONLY — never expose to the browser).
# Used to write orbital_snapshots (app-owned history, RLS-closed).
SUPABASE_SERVICE_ROLE_KEY=
# Anonymous key for user-scoped watchlist access (RLS-protected).
SUPABASE_ANON_KEY=

# --- to activate persistence -----------------------------------------------
# Apply the migrations in supabase/migrations/ with the Supabase CLI:
#   supabase db push
