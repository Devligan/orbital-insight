{
  "name": "orbital-insight",
  "version": "0.1.0",
  "private": true,
  "description": "Satellite analysis platform: live CelesTrak orbital data, SGP4 propagation, ground tracks, pass predictions.",
  "scripts": {
    "prebuild": "node scripts/build-search-index.mjs && node scripts/copy-cesium.mjs",
    "predev": "node scripts/copy-cesium.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:bundle && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "11.7.0",
    "@supabase/supabase-js": "^2.117.3",
    "cesium": "^1.146.0",
    "next": "15.5.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "satellite.js": "^7.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
